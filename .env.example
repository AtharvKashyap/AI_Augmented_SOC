# AI_Augmented_SOC environment template
#
# Purpose:
#   Defines all environment variables used by the project.
#
# Usage:
#   1. Copy this file:
#        cp .env.example .env
#   2. Fill in real values in .env
#   3. Never commit .env
#
# Security:
#   This file should contain placeholders only. Real API keys, passwords,
#   tokens, and SOC credentials belong in .env or a secrets manager.

# ---------------------------------------------------------------------
# Core runtime settings
# ---------------------------------------------------------------------

POLL_INTERVAL_SECONDS=120
ALERT_LOOKBACK_MINUTES=5
OUTPUT_DIR=output
LOG_DIR=logs

# ---------------------------------------------------------------------
# Wazuh
# ---------------------------------------------------------------------
# Current live mode is Manager-only friendly.
#
# If you do not have Wazuh Indexer access, set WAZUH_ALERT_SOURCE=json_logs
# and point WAZUH_ALERT_JSON_PATH at a readable Wazuh alerts.json file.
#
# Common options:
#   - Run this project on the Wazuh Manager host and read:
#       /var/ossec/logs/alerts/alerts.json
#   - Or copy/scp alerts.json to this project machine and point the path below
#     at the copied file, for example data/alerts.json.
#
# Wazuh Manager API is still useful for authentication checks and agent
# inventory context, usually exposed on port 55000.

WAZUH_MANAGER_URL=https://your-wazuh-manager:55000
WAZUH_MANAGER_USER=wazuh-wui
WAZUH_MANAGER_PASSWORD=replace-me
WAZUH_MANAGER_VERIFY_TLS=false

# Alert source used by run_pipeline.py --wazuh.
# Current supported live-test mode for Manager-only deployments:
#   json_logs
WAZUH_ALERT_SOURCE=json_logs

# Path to Wazuh line-delimited JSON alerts.
# On the Wazuh Manager host, this is usually:
#   /var/ossec/logs/alerts/alerts.json
# If testing from your laptop, copy/scp that file and use a local path like:
#   data/alerts.json
WAZUH_ALERT_JSON_PATH=/var/ossec/logs/alerts/alerts.json

# Wazuh alert filtering.
# For the first live test, use a larger lookback and lower minimum level so
# you actually catch alerts. Tighten these later.
WAZUH_ALERT_LOOKBACK_MINUTES=1440
WAZUH_ALERT_LIMIT=20
WAZUH_MIN_LEVEL=0

# ---------------------------------------------------------------------
# Security Onion
# ---------------------------------------------------------------------
# Live ingestion uses the Security Onion Connect API on the manager.
# Keep access restricted to the SOC/management network.
#
# IMPORTANT: the Connect API is an enterprise feature and requires a
# Security Onion Pro license. Without one, these settings will not
# authenticate; use replay fixtures until an alternative read path exists.
#
# Create an API client in the Security Onion Console as a superuser:
#   Administration -> API Clients -> new client
# Grant it the events/read permission. Saving the client issues the secret.

SECURITYONION_HOST=https://your-securityonion
SECURITYONION_CLIENT_ID=replace-me
SECURITYONION_CLIENT_SECRET=replace-me
SECURITYONION_VERIFY_TLS=true

# Query bounds for each Security Onion poll.
SECURITYONION_LOOKBACK_MINUTES=60
SECURITYONION_ALERT_LIMIT=100

# Only needed when querying through a Manager of Managers node.
SECURITYONION_GRID_ID=

# Console credentials. Not used by the Connect API, which authenticates with
# the client ID and secret above. Retained for any future index-level access.
SECURITYONION_USER=replace-me
SECURITYONION_PASSWORD=replace-me

# Minimum Security Onion severity to ingest.
SO_MIN_SEVERITY=2

# Optional index/query settings. Exact values may change based on how
# Security Onion is deployed.
SECURITYONION_ALERT_INDEX=so-ids-*
SECURITYONION_ZEEK_INDEX=so-zeek-*

# ---------------------------------------------------------------------
# OpenRouter LLM
# ---------------------------------------------------------------------
# OpenRouter provides an OpenAI-compatible chat completions API.
# Use a free model for development/testing, but use a pinned reliable
# model for production-like testing.

OPENROUTER_API_KEY=replace-me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Pick the model in OpenRouter. This is intentionally configurable.
OPENROUTER_MODEL=openrouter/free

# Optional separate model for report writing.
# If empty, the app can fall back to OPENROUTER_MODEL.
OPENROUTER_REPORT_MODEL=

# Optional headers sometimes used by OpenRouter rankings/analytics.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=AI_Augmented_SOC

# ---------------------------------------------------------------------
# Threat intelligence enrichment
# ---------------------------------------------------------------------
# These are optional. If unset, enrichment should be skipped gracefully.

VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=

# Cache enrichment results to avoid repeated API calls.
ENRICHMENT_CACHE_TTL_HOURS=24

# Optional asset inventory CSV. Requires a `hostname` column; `ip`, `owner`,
# `criticality`, `internet_facing` and `department` are optional and any other
# columns are ignored, so a CMDB export can be used as-is. Leave blank to run
# without asset context, which is a supported mode. Asset criticality is often
# what separates queueing an alert from paging someone.
ASSET_INVENTORY_PATH=

# ---------------------------------------------------------------------
# Routing and notifications
# ---------------------------------------------------------------------

EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
EMAIL_USE_TLS=true

# Later option.
SLACK_WEBHOOK_URL=

# ---------------------------------------------------------------------
# Storage and deduplication
# ---------------------------------------------------------------------

DEDUP_STORE=sqlite
SQLITE_DB_PATH=ai_soc.db
REDIS_URL=redis://localhost:6379/0

# Default time to remember processed alert IDs.
DEDUP_TTL_HOURS=24

# ---------------------------------------------------------------------
# Testing in low-alert environments
# ---------------------------------------------------------------------
# Useful when the real SOC does not generate enough alerts to validate
# triage, clustering, reporting, and routing.

ENABLE_SAMPLE_REPLAY=false
SAMPLE_REPLAY_FILE=tests/fixtures/sample_incident_replay.json
MANUAL_TEST_EVENTS_DIR=tests/fixtures/manual_events

# ---------------------------------------------------------------------
# Later phase: Splunk output
# ---------------------------------------------------------------------
# Not required for MVP. Used later to push AI triage results into Splunk.

SPLUNK_HEC_URL=
SPLUNK_HEC_TOKEN=
SPLUNK_HEC_INDEX=
SPLUNK_HEC_SOURCETYPE=ai_triage

# ---------------------------------------------------------------------
# Later phase: OpenBSD firewall integration
# ---------------------------------------------------------------------
# Not required for MVP. Used later for pflog visibility and human-approved
# pfctl response actions.

OPENBSD_PF_ENABLED=false
OPENBSD_PF_HOST=
OPENBSD_PF_USER=
OPENBSD_PFLOG_PATH=/var/log/pflog

# Path to pflog TEXT output, which is what ingestion actually reads.
# /var/log/pflog above is a pcap file and cannot be parsed directly. Produce
# text with:
#   tcpdump -n -e -ttt -r /var/log/pflog > /path/to/pflog.txt
# Leave blank to run without pflog ingestion, which is a supported mode.
OPENBSD_PFLOG_TEXT_PATH=
OPENBSD_PF_BLOCK_TABLE=ai_soc_blocklist