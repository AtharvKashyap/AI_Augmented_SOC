---

## `.env.example`

```bash
# AI_Augmented_SOC environment template
#
# Purpose:
#   Defines all environment variables used by the project.
#
# Usage:
#   1. Copy this file:
#        cp .env.example .env
#   2. Fill in real values in .env
#   3. Never commit .env
#
# Security:
#   This file should contain placeholders only. Real API keys, passwords,
#   tokens, and SOC credentials belong in .env or a secrets manager.

# ---------------------------------------------------------------------
# Core runtime settings
# ---------------------------------------------------------------------

POLL_INTERVAL_SECONDS=120
ALERT_LOOKBACK_MINUTES=5
OUTPUT_DIR=output
LOG_DIR=logs

# ---------------------------------------------------------------------
# Wazuh
# ---------------------------------------------------------------------
# Wazuh Manager API is commonly exposed on port 55000.
# Use a read-only or least-privilege account where possible.

WAZUH_HOST=https://your-wazuh-manager:55000
WAZUH_USER=wazuh-wui
WAZUH_PASSWORD=replace-me

# Minimum Wazuh rule level to ingest.
# Common starting point: 7.
WAZUH_MIN_LEVEL=7

# Supported future options:
#   api
#   indexer
#   json_logs
#   security_onion_mirror
WAZUH_ALERT_SOURCE=api

# Optional path if using local Wazuh alert JSON logs later.
WAZUH_ALERT_JSON_PATH=/var/ossec/logs/alerts/alerts.json

# ---------------------------------------------------------------------
# Security Onion
# ---------------------------------------------------------------------
# Use whichever Security Onion search/API endpoint is available in the
# deployment. Keep access restricted to the SOC/management network.

SECURITYONION_HOST=https://your-securityonion
SECURITYONION_USER=replace-me
SECURITYONION_PASSWORD=replace-me

# Minimum Security Onion severity to ingest.
SO_MIN_SEVERITY=2

# Optional index/query settings. Exact values may change based on how
# Security Onion is deployed.
SECURITYONION_ALERT_INDEX=so-ids-*
SECURITYONION_ZEEK_INDEX=so-zeek-*

# ---------------------------------------------------------------------
# OpenRouter LLM
# ---------------------------------------------------------------------
# OpenRouter provides an OpenAI-compatible chat completions API.
# Use a free model for development/testing, but use a pinned reliable
# model for production-like testing.

OPENROUTER_API_KEY=replace-me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Pick the model in OpenRouter. This is intentionally configurable.
OPENROUTER_MODEL=openrouter/free

# Optional separate model for report writing.
# If empty, the app can fall back to OPENROUTER_MODEL.
OPENROUTER_REPORT_MODEL=

# Optional headers sometimes used by OpenRouter rankings/analytics.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=AI_Augmented_SOC

# ---------------------------------------------------------------------
# Threat intelligence enrichment
# ---------------------------------------------------------------------
# These are optional. If unset, enrichment should be skipped gracefully.

VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=

# Cache enrichment results to avoid repeated API calls.
ENRICHMENT_CACHE_TTL_HOURS=24

# ---------------------------------------------------------------------
# Routing and notifications
# ---------------------------------------------------------------------

EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
EMAIL_USE_TLS=true

# Later option.
SLACK_WEBHOOK_URL=

# ---------------------------------------------------------------------
# Storage and deduplication
# ---------------------------------------------------------------------

DEDUP_STORE=sqlite
SQLITE_DB_PATH=ai_soc.db
REDIS_URL=redis://localhost:6379/0

# Default time to remember processed alert IDs.
DEDUP_TTL_HOURS=24

# ---------------------------------------------------------------------
# Testing in low-alert environments
# ---------------------------------------------------------------------
# Useful when the real SOC does not generate enough alerts to validate
# triage, clustering, reporting, and routing.

ENABLE_SAMPLE_REPLAY=false
SAMPLE_REPLAY_FILE=tests/fixtures/sample_incident_replay.json
MANUAL_TEST_EVENTS_DIR=tests/fixtures/manual_events

# ---------------------------------------------------------------------
# Later phase: Splunk output
# ---------------------------------------------------------------------
# Not required for MVP. Used later to push AI triage results into Splunk.

SPLUNK_HEC_URL=
SPLUNK_HEC_TOKEN=
SPLUNK_HEC_INDEX=
SPLUNK_HEC_SOURCETYPE=ai_triage

# ---------------------------------------------------------------------
# Later phase: OpenBSD firewall integration
# ---------------------------------------------------------------------
# Not required for MVP. Used later for pflog visibility and human-approved
# pfctl response actions.

OPENBSD_PF_ENABLED=false
OPENBSD_PF_HOST=
OPENBSD_PF_USER=
OPENBSD_PFLOG_PATH=/var/log/pflog
OPENBSD_PF_BLOCK_TABLE=ai_soc_blocklist